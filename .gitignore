# Рабочие секреты и локальные настройки; шаблон сохраняем.
.env
.env.*
!.env.example
.envrc
*.local

# Документы организации, локальные данные и временные материалы.
/data/
/work/
/outputs/
/backups/
/upload.json

# Локальная память помощника и служебные файлы SQLite.
/sqlite-memory.db
/sqlite-memory.db-shm
/sqlite-memory.db-wal
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

# Кеши и снимки оформления; настройки дизайна сохраняем.
/.impeccable/hook.cache.json
/.impeccable/questions/
/.impeccable/review/

# Виртуальные среды и локально установленные зависимости.
.venv/
venv/
env/
.test-deps/
.dev-deps/
node_modules/

# Кеши Python, тестов, анализа и менеджеров пакетов.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.uv-cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Сборка и упаковка; lock-файлы не исключаются.
build/
dist/
.build-temp/
*.egg-info/
*.egg
pip-wheel-metadata/

# Журналы и временные копии редакторов.
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Локальные файлы IDE и операционной системы.
.idea/
.vs/
*.user
*.suo
.DS_Store
Thumbs.db
Desktop.ini
VERIFIED.md
examples/demo.md
