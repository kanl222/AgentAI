      "css": ".ds-secondary{border:0;border-radius:8px;padding:12px 17px;font:600 13px \"Segoe UI\",sans-serif;background:var(--shell,#f5f5f5);color:var(--ink,#171717);cursor:pointer}.ds-secondary:hover{background:var(--hover,#ebebeb)}.ds-secondary:focus-visible{outline:2px solid var(--accent,#171717);outline-offset:4px}"
