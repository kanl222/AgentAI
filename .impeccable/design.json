      "css": ".ds-primary{border:0;border-radius:8px;padding:12px 17px;font:600 13px \"Segoe UI\",sans-serif;background:var(--accent,#171717);color:var(--on-accent,#ffffff);cursor:pointer}.ds-primary:hover{background:var(--accent-hover,#404040)}.ds-primary:focus-visible{outline:2px solid var(--accent,#171717);outline-offset:4px}"
