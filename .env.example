# Template only. Keep actual credentials in .env.
AGENT_USERS=[]
WEBUI_READER_KEY=replace-with-random-reader-key
WEBUI_SECRET_KEY=replace-with-long-random-secret
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_API_KEY=lm-studio
QDRANT_URL=http://qdrant:6333
CHAT_MODEL=qwen/qwen3-4b-2507
EMBED_MODEL=qwen3-embedding-0.6b
EMBED_BASE_URL=http://embeddings:8080/v1
EMBED_API_KEY=local-embeddings
EMBED_QUERY_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query
QDRANT_COLLECTION=agentai_qwen3_embedding_0_6b
MAX_STEPS=4
# Qwen3-4B-Instruct-2507 recommended sampling profile.
CHAT_TEMPERATURE=0.7
CHAT_TOP_P=0.8
CHAT_TOP_K=20
CHAT_MIN_P=0
CHAT_PRESENCE_PENALTY=0
# Output budget leaves room for the question, documents and history.
CHAT_MAX_TOKENS=4096
# Context for input + output. Apply on the LM Studio host with scripts/configure_model_context.py.
CHAT_CONTEXT_LENGTH=16384
GITLAB_URL=https://gitlab.example.org
GITLAB_TOKEN=
GITLAB_SOURCES={}
SQL_CONNECTION_STRING=
DOCUMENTS_INDEXER_KEY=
POSTGRES_PASSWORD=replace-with-random-hex-password
CONVERSATION_RETENTION_DAYS=30
MAX_PENDING_JOBS=32
SEARCH_ALIASES={}
CHAT_QUEUE_WAIT_SECONDS=240
# In-memory caches; 0 disables the corresponding cache.
RETRIEVAL_CACHE_ENTRIES=4
RETRIEVAL_CACHE_TTL_SECONDS=30
QUERY_EMBED_CACHE_ENTRIES=64
QUERY_EMBED_CACHE_TTL_SECONDS=300
# RAG limits. Chunk changes apply on the next indexing operation.
RAG_CHUNK_CHARS=3500
RAG_CHUNK_OVERLAP=400
RAG_CHUNK_LINES=50
RAG_CANDIDATES=20
RAG_TOP_K=6
RAG_CONTEXT_CHARS=12000
# Internal Compose service. Empty OCR_URL disables OCR for native text PDFs.
OCR_URL=http://ocr:8000
